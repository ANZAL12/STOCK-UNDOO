# STOCK UNDO! Backend Environment Variables
APP_NAME="STOCK UNDO!"
TAGLINE="Check stock before you call the godown!"

# Security Token (shared between Vercel frontend and Cloudflare Tunnel / FastAPI)
STAFF_ACCESS_TOKEN=stock-undo-staff-secure-token-2026
SECRET_KEY=stock-undo-internal-secret-key-salt
REQUIRE_AUTH=false

# PC 1 Tally Connectivity (Localhost on Port 9000)
PC1_HOST=127.0.0.1
PC1_PORT=9000
PC1_LABEL="Tally PC 1 (Central)"

# PC 2 Tally Connectivity (Tailscale Private Mesh IP)
PC2_HOST=100.101.152.68
PC2_PORT=9000
PC2_LABEL="Tally PC 2 (Branch / Godown)"

# Timing & Throttling
TALLY_TIMEOUT_SECONDS=3.5
CACHE_TTL_SECONDS=30
RATE_LIMIT_PER_MINUTE=60

