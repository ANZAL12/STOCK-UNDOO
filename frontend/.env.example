# STOCK UNDO! Frontend Environment Variables

# For Local Development (Empty string uses Vite proxy to localhost:8000)
VITE_API_BASE_URL=

# For Vercel Production Deployment:
# Point to your Cloudflare Tunnel public HTTPS URL (e.g. https://stock-undo-api.yourcompany.com)
# VITE_API_BASE_URL=https://stock-undo-api.yourcompany.com

